# Public read-only sources
BLACKBIT_ENABLED=true
BLACKBIT_API_BASE_URL=https://blackbit.exchange/site
WINANCE_ENABLED=true
WINANCE_API_URL=https://winance.exchange/site/currency_pairs
WINANCE_POLL_SECONDS=300

# Money Storage stays disabled until a permitted cloud access method is verified.
MONEY_STORAGE_ENABLED=false
MONEY_STORAGE_CLOUD_ACCESS_APPROVED=false
MONEY_STORAGE_API_URL=https://storage.money/public_deals/fetch
MONEY_STORAGE_FROM=ECR
MONEY_STORAGE_TO=USDT
MONEY_STORAGE_TIMEOUT_SECONDS=20

# Unknown fees must remain blank; the route calculator will refuse to assume zero.
FEE_BLACKBIT_PERCENT=
FEE_WINANCE_PERCENT=
FEE_SBERKASSA_SELL_PERCENT=
FEE_SBERKASSA_EXCHANGE_PERCENT=

STARTING_AMOUNT_USDT=1000
QUOTE_MAX_AGE_SECONDS=900
QUOTE_DATABASE_PATH=/app/data/quotes.sqlite3
