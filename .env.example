# Public read-only API adapters
BLACKBIT_API_BASE_URL=https://blackbit.exchange/site
WINANCE_API_URL=https://winance.exchange/site/currency_pairs

# The integrated collector rejects any quote older than this maximum age.
QUOTE_MAX_AGE_SECONDS=900

# Sanitized snapshots produced by the authenticated shared Chromium workflow.
MONEY_STORAGE_SNAPSHOT_PATH=money-storage-current-offers.json
SBERKASSA_SELL_SNAPSHOT_PATH=sberkassa-current-inspection.json
SBERKASSA_EXCHANGE_SNAPSHOT_PATH=sberkassa-exchange-inspection.json

# Starting capital is intentionally not set here. The current report is normalized per 1 USDT.
# Route fees are temporary 0% placeholders until manual calculator settings are configured.
