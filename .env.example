BLACKBIT_API_BASE_URL=https://blackbit.exchange/site\n\nWINANCE_API_URL=https://winance.exchange/site/currency_pairs
WINANCE_POLL_SECONDS=300
QUOTE_MAX_AGE_SECONDS=900
STARTING_AMOUNT_USDT=1000

# Money Storage public read-only endpoint (no browser cookies/session supported)
MONEY_STORAGE_API_URL=https://storage.money/public_deals/fetch
# Confirmed from the authenticated Deals -> Everyone Offers frontend request.
# Raw API src=ECR,dst=USDT renders as displayed Give USDT / Receive ECR.
MONEY_STORAGE_FROM=ECR
MONEY_STORAGE_TO=USDT
MONEY_STORAGE_TIMEOUT_SECONDS=20
