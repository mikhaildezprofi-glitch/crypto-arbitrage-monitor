{
  "name": "Crypto arbitrage private E-ID browser",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Private E-ID browser",
      "visibility": "private",
      "protocol": "https"
    }
  },
  "postCreateCommand": "bash .devcontainer/install-browser.sh",
  "postStartCommand": "bash .devcontainer/restore-private-profile.sh",
  "remoteEnv": {
    "CODESPACES_MODE": "1"
  },
  "shutdownAction": "stopContainer"
}
